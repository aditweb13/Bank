# ──────────────────────────────────────────────────────────────────
# ARBC Bank – Environment Variables Template
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# Never commit .env to git.
# ──────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection URL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/arbc_bank_db

# Database credentials
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_before_running

# ── JWT Security ───────────────────────────────────────────────────
# Minimum 32 characters; generate a secure value with:
#   openssl rand -base64 64
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Token lifetimes in milliseconds
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Spring Profile ────────────────────────────────────────────────
# Options: local | prod
SPRING_PROFILES_ACTIVE=local

# ── Frontend (Vite) ───────────────────────────────────────────────
# Backend API URL for the frontend proxy. Leave blank for local dev proxy.
VITE_API_BASE_URL=http://localhost:8080
